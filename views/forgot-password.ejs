<!DOCTYPE html>
<html>
<head>
    <title>Forgot Password</title>
</head>
<body>

    <h2>Reset Password</h2>

    <form action="/forgot-password" method="POST">

        <input
            type="text"
            name="username"
            placeholder="Username"
            required
        >

        <br><br>

        <input
            type="password"
            name="newPassword"
            placeholder="New Password"
            required
        >

        <br><br>

        <button type="submit">
            Reset Password
        </button>

    </form>

</body>
</html>