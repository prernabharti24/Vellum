<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note - Vellum</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container">

    <div class="header">
        <h1>Edit Note</h1>
        <p>Update your saved note</p>
    </div>

    <div class="form-card">

        <form action="/update/<%= note.id %>" method="POST">

            <input
                type="text"
                name="title"
                value="<%= note.title %>"
                required>

            <textarea
                name="content"
                rows="8"
                required><%= note.content %></textarea>

           <button
    type="submit"
    class="btn">

    💾 Update Note

</button>
        </form>

        <br>

        <a href="/" class="btn secondary-btn">
    ⬅️ Back to Notes
</a>

    </div>

</div>

</body>
</html>