<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Note - Vellum</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <div class="header">
        <h1>Edit Note</h1>
        <p>Update your saved note</p>
    </div>

    <div class="form-card">

        <form action="/update/<%= note.id %>" method="POST">

            <input
                type="text"
                name="title"
                value="<%= note.title %>"
                required>

            <textarea
                name="content"
                rows="8"
                required><%= note.content %></textarea>

            <button class="btn" type="submit">
                Update Note
            </button>

        </form>

        <br>

        <a href="/">← Back to Notes</a>

    </div>

</div>

</body>
</html>