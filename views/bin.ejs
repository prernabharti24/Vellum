<!DOCTYPE html>
<html>
<head>
    <title>Recycle Bin</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container">

<div class="bin-header">

    <div>

        <h1>🗑️ Recycle Bin</h1>

        <p class="bin-subtitle">
            Deleted notes can be restored anytime.
        </p>

    </div>

    <a href="/" class="btn secondary-btn">
        ⬅️ Back to Notes
    </a>

</div>
<% notes.forEach(note => { %>

<div class="deleted-note-card">

    <h3>
        📝 <%= note.title %>
    </h3>

    <p class="created-date">
        🗑️ Deleted:
        <%= new Date(note.deleted_at).toLocaleString() %>
    </p>

    <div class="deleted-note-actions">

        <a href="/restore/<%= note.id %>"
           class="btn restore-btn">

            ♻️ Restore

        </a>

    </div>

</div>

<% }) %>

</div>

</body>
</html>